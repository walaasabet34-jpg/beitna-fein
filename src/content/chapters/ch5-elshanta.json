  "calendarStatus": "provisional",
  "nodes": [
    {
      "id": "g_start",
      "type": "card",
      "title": "الفصل السادس",
      "subtitle": "الشنطة",
      "cast": [],
      "music": null,
      "broadcast": null
    },
    {
      "id": "g_home",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي كبايتين. رجعتي واحدة قبل ما تمليها."
    },
    {
      "id": "g_objects",
      "type": "choice",
      "prompt": "الطلبية قدامك، لكن عينك على حاجتها. تبدأي بإيه؟",
      "options": [
        {
          "text": "تفتحي الكراسة.",
          "goto": "g_notebook",
          "effects": {
            "flags": {
              "grief_opened_book": true
            },
            "vars": {}
          }
        },
        {
          "text": "تلمي الهدوم المطوية.",
          "goto": "g_clothes",
          "effects": {
            "flags": {
              "grief_folded": true
            },
            "vars": {}
          }
        },
        {
          "text": "تسيبي كل حاجة مكانها النهارده.",
          "goto": "g_leave",
          "effects": {
            "flags": {
              "grief_left_room": true
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_notebook",
      "type": "line",
      "speaker": "narrator",
      "text": "في الكراسة حساب وإملا ورسم ناقص. عند آخر صفحة، القلم متني جوه الغلاف.",
      "next": "g_war_memory"
    },
    {
      "id": "g_clothes",
      "type": "line",
      "speaker": "narrator",
      "text": "فردتي الكم قبل ما تطويه، مع إنه مش هيتكرمش على دراعها تاني. تحت الهدوم كراستها.",
      "next": "g_war_memory"
    },
    {
      "id": "g_leave",
      "type": "line",
      "speaker": "narrator",
      "text": "سيبتي الحاجات مكانها. لما رجعتي للماكينة، الكراسة فضلت في طرف عينك.",
      "next": "g_war_memory"
    },
    {
      "id": "g_war_memory",
      "type": "line",
      "speaker": "narrator",
      "text": "الكراسة فضلت مكانها على طرف الترابيزة.",
      "variants": [
        {
          "if": {
            "flag": "war_shared_joy"
          },
          "text": "افتكرتي كفها وهو بيخبط في كفك يوم العبور، وبعدين جريها على الشباك."
        },
        {
          "if": {
            "flag": "war_return_promise"
          },
          "text": "افتكرتي يوم قلتي لها إن الرجوع قريب. سمعتي سؤالها تاني: قريب قد إيه؟"
        },
        {
          "if": {
            "flag": "war_silenced"
          },
          "text": "افتكرتي صوتك يوم الخبر: «ثانية يا هدى، عايزة أسمع الباقي.» وعينها عليكي بعد ما سكتت."
        }
      ]
    },
    {
      "id": "g_contact",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة خبطت: «أمها عندي من الليلة اللي رجعنا فيها من المستشفى. طالبة تشوفك.»",
      "scene": "door",
      "cast": [
        "naima"
      ],
      "effects": {
        "setTime": {
          "day": 2,
          "slot": 0
        }
      }
    },
    {
      "id": "g_identity",
      "type": "line",
      "speaker": "naima",
      "text": "«رجعت على عنوان سنية وملقتهاش. سابت عنوانها عند عم فوزي. جوابكم هو اللي وصلها لك.»"
    },
    {
      "id": "g_news",
      "type": "line",
      "speaker": "naima",
      "text": "«قلت لها إن هدى ماتت قبل ما تطلب تقابلك. عايزة تاخد حاجات بنتها.»"
    },
    {
      "id": "g_meet",
      "type": "choice",
      "prompt": "إنتي قادرة تقابليها؟",
      "options": [
        {
          "text": "«خليها تيجي. هقابلها.»",
          "goto": "g_yes",
          "effects": {
            "flags": {
              "mother_meeting": "now"
            },
            "vars": {}
          }
        },
        {
          "text": "«مش النهارده. بعد يومين، وهكون موجودة.»",
          "goto": "g_later",
          "effects": {
            "flags": {
              "mother_meeting": "later"
            },
            "vars": {}
          }
        },
        {
          "text": "«خدي إنتي الشنطة لها. مش قادرة أقابلها.»",
          "goto": "g_send",
          "effects": {
            "flags": {
              "mother_meeting": "messenger"
            },
            "vars": {}
          }
        },
        {
          "text": "«مش هقابلها، ومش هقدر أسلّم الحاجات دلوقتي.»",
          "goto": "g_refuse",
          "effects": {
            "flags": {
              "mother_meeting": "refused"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_yes",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي كرسيًا تاني جنب الطبلية، ورجعتي للشنطة.",
      "scene": "living",
      "cast": [],
      "next": "g_prepare"
    },
    {
      "id": "g_later",
      "type": "line",
      "speaker": "narrator",
      "text": "«بعد يومين.» نعيمة نزلت تبلغها بالموعد.",
      "scene": "living",
      "cast": [],
      "next": "g_prepare"
    },
    {
      "id": "g_send",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة فردت شالها، وحطت الشنطة جنبها تستنى تجهزيها.",
      "scene": "living",
      "cast": [
        "naima"
      ],
      "next": "g_prepare"
    },
    {
      "id": "g_refuse",
      "type": "line",
      "speaker": "naima",
      "text": "«هقول لها إنك مش قادرة. بس هي مستنية حاجات بنتها.»",
      "scene": "living",
      "cast": [
        "naima"
      ],
      "next": "g_hold"
    },
    {
      "id": "g_hold",
      "type": "choice",
      "prompt": "بعد كلام نعيمة:",
      "options": [
        {
          "text": "تراجعي قرارك وتبعتي الحاجات معاها.",
          "goto": "g_send",
          "effects": {
            "flags": {
              "mother_meeting": "messenger",
              "grief_reconsidered": true
            },
            "vars": {}
          }
        },
        {
          "text": "تسمحي بالمقابلة، حتى لو مش عارفة هتقولي إيه.",
          "goto": "g_yes",
          "effects": {
            "flags": {
              "mother_meeting": "now",
              "grief_reconsidered": true
            },
            "vars": {}
          }
        },
        {
          "text": "تفضلي رافضة دلوقتي.",
          "goto": "g_hold_end",
          "effects": {
            "flags": {
              "belongings_delivery": "withheld"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_hold_end",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة خرجت من غير الشنطة. من الشباك، سمعتي صوت الباب اللي تحت.",
      "next": "final_keep",
      "cast": []
    },
    {
      "id": "final_keep",
      "type": "choice",
      "prompt": "الشنطة لسه عند الباب.",
      "options": [
        {
          "text": "(تسيبيها مكانها)",
          "goto": "final_keep_door",
          "effects": {
            "flags": {
              "last_action": "door"
            },
            "vars": {}
          }
        },
        {
          "text": "(تحطيها جنب الماكينة)",
          "goto": "final_keep_machine",
          "effects": {
            "flags": {
              "last_action": "machine"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "final_keep_door",
      "type": "line",
      "text": "بعدتي إيدك عن القفل. طلب أمها لسه من غير رد.",
      "speaker": "narrator",
      "next": "g_end_hold"
    },
    {
      "id": "final_keep_machine",
      "type": "line",
      "text": "حرّكتيها عشان تعرفي تعدّي. مكانها ما وسّعش الأوضة.",
      "speaker": "narrator",
      "next": "g_end_hold"
    },
    {
      "id": "g_prepare",
      "type": "choice",
      "prompt": "تجهزي الشنطة إزاي؟",
      "options": [
        {
          "text": "تحطي كل حاجتها؛ ماتحتفظيش بحاجة من غير سؤال.",
          "goto": "g_all",
          "effects": {
            "flags": {
              "keepsake_request": "none"
            },
            "vars": {}
          }
        },
        {
          "text": "تحطي كل حاجتها وتطلبي من الأم الاحتفاظ برسمة، لو وافقت.",
          "goto": "g_request",
          "effects": {
            "flags": {
              "keepsake_request": "drawing"
            },
            "vars": {}
          }
        },
        {
          "text": "تكتبي سطر عن كل حاجة تفتكريها، وتحطي الورقة مع الحاجات.",
          "goto": "g_note",
          "effects": {
            "flags": {
              "keepsake_request": "note",
              "memory_note": true
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_all",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي المشط والهدوم والكراسة. كل مرة تفتكري إنك خلصتي، تلاقي حاجة صغيرة لسه برّه.",
      "next": "grief_letter"
    },
    {
      "id": "g_request",
      "type": "line",
      "speaker": "narrator",
      "text": "الرسمة دخلت الشنطة مع الباقي. كتبتي طلبك على ورقة؛ لو رفضت، هتفضل الرسمة معاها.",
      "next": "grief_letter"
    },
    {
      "id": "g_note",
      "type": "line",
      "speaker": "narrator",
      "text": "كتبتي اللي تقدري تقولي لها عن أيام هدى هنا. وقفتي عند سطر مش عارفة تكمّليه.",
      "next": "grief_letter"
    },
    {
      "id": "grief_letter",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "letter_to_mother"
          },
          "goto": "grief_letter_read"
        }
      ],
      "else": "g_seam"
    },
    {
      "id": "grief_letter_read",
      "type": "line",
      "text": "جواب هدى لأمها لسه مطبّق. حطيتيه فوق الهدوم؛ على الوش مكتوب: لماما.",
      "speaker": "narrator",
      "effects": {
        "flags": {
          "letter_delivered_with_bag": true
        },
        "vars": {}
      },
      "next": "g_seam"
    },
    {
      "id": "g_seam",
      "type": "line",
      "speaker": "narrator",
      "text": "جوه الشنطة اسمها بالقلم. أول مرة من زمان، قعدتي تبصي له من غير ما تدوري على حاجة تانية.",
      "variants": [
        {
          "if": {
            "flag": "memory_stitch"
          },
          "text": "أول حرفين بالخيط. الباقي بالقلم."
        },
        {
          "if": {
            "flag": "memory_refused"
          },
          "text": "الاسم كله بالقلم. الإبرة اللي طلبتها يومها كانت في درجك."
        }
      ]
    },
    {
      "id": "g_route",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "mother_meeting",
            "eq": "messenger"
          },
          "goto": "g_messenger"
        },
        {
          "if": {
            "flag": "mother_meeting",
            "eq": "later"
          },
          "goto": "g_dec12"
        }
      ],
      "else": "g_arrival"
    },
    {
      "id": "g_dec12",
      "type": "line",
      "speaker": "narrator",
      "text": "اليوم اللي حددتيه وصل. نعيمة خبطت على الباب.",
      "effects": {
        "setTime": {
          "day": 3,
          "slot": 0
        }
      },
      "next": "g_arrival"
    },
    {
      "id": "g_arrival",
      "type": "line",
      "speaker": "narrator",
      "text": "دخلت أم هدى ومعاها نعيمة. قالت اسم بنتها كاملًا قبل ما تقعد. حطيتي الشنطة بينكم، ومافيش حد مد إيده يفتحها.",
      "scene": "living",
      "cast": [
        "mother",
        "naima"
      ],
      "music": null
    },
    {
      "id": "g_mother_ask",
      "type": "line",
      "speaker": "mother",
      "text": "«احكيلي عنها هنا. كانت بتعمل إيه؟»"
    },
    {
      "id": "g_relation",
      "type": "line",
      "speaker": "narrator",
      "text": "أمها مستنية تسمع. صوت الماكينة في الشقة اللي جنبكم وقف.",
      "variants": [
        {
          "if": {
            "flag": "relationship_before_illness",
            "eq": "warm"
          },
          "text": "أمها قرّبت كرسيها منك، واستنت تسمع."
        },
        {
          "if": {
            "flag": "relationship_before_illness",
            "eq": "closed"
          },
          "text": "حاولتي تفتكري حاجة كانت بتحب تعملها لوحدها. أمها فضلت مستنية."
        }
      ]
    },
    {
      "id": "g_account",
      "type": "choice",
      "prompt": "تختاري تحكي إزاي؟",
      "options": [
        {
          "text": "«كانت بتدور على المشط كل شوية.»",
          "goto": "g_account_true",
          "effects": {
            "flags": {
              "mother_account": "truth"
            },
            "vars": {}
          }
        },
        {
          "text": "«كنت بصدّها لما تطلب مني حاجة…»",
          "goto": "g_account_fault",
          "effects": {
            "flags": {
              "mother_account": "admitted"
            },
            "vars": {}
          },
          "if": {
            "any": [
              {
                "flag": "memory_refused"
              },
              {
                "flag": "war_snap"
              },
              {
                "flag": "news_dismissed"
              },
              {
                "flag": "lied_bag"
              },
              {
                "flag": "promise_broken"
              }
            ]
          }
        },
        {
          "text": "«كانت كويسة معايا.»",
          "goto": "g_account_hide",
          "effects": {
            "flags": {
              "mother_account": "evasive"
            },
            "vars": {}
          }
        },
        {
          "text": "«مش عارفة أتكلم. تحبي تشوفي كراستها؟»",
          "goto": "g_account_silent",
          "effects": {
            "flags": {
              "mother_account": "silent"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_account_true",
      "type": "line",
      "speaker": "fatma",
      "text": "كانت بتدوّر على المشط كل شوية. وتنسى هي حطّته فين.",
      "next": "g_mother_seam",
      "variants": [
        {
          "if": {
            "flag": "war_comb"
          },
          "text": "مرة طلع المشط تحت الكراسة. كنت بدوّر عليه معاها."
        }
      ]
    },
    {
      "id": "g_account_fault",
      "type": "line",
      "speaker": "mother",
      "text": "طب احكيلي كانت بتعمل إيه لوحدها.",
      "next": "g_mother_seam"
    },
    {
      "id": "g_account_hide",
      "type": "line",
      "speaker": "mother",
      "text": "كانت مبسوطة؟ كانت بتتكلم؟",
      "next": "g_mother_seam"
    },
    {
      "id": "g_account_silent",
      "type": "line",
      "speaker": "narrator",
      "text": "طلعتي الكراسة من الشنطة وفتحتيها. الأم قلبت الصفحات، ونعيمة قاعدة جنبها.",
      "next": "g_mother_seam"
    },
    {
      "id": "g_mother_seam",
      "type": "line",
      "speaker": "narrator",
      "text": "فتحتي الشنطة على الآخر وورّيتيها الاسم على القماش. الأم مرّرت صباعها عليه: «هي اللي عملته؟»"
    },
    {
      "id": "g_seam_answer",
      "type": "choice",
      "prompt": "تردّي عليها:",
      "options": [
        {
          "text": "تقولي بالضبط إيه اللي هدى عملته وإنتي ساعدتي في إيه.",
          "goto": "g_seam_truth",
          "effects": {
            "flags": {
              "seam_answer": "truth"
            },
            "vars": {}
          }
        },
        {
          "text": "تكتفي بهزة راس، وتسيبيها تبص.",
          "goto": "g_seam_nod",
          "effects": {
            "flags": {
              "seam_answer": "nod"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_seam_truth",
      "type": "line",
      "speaker": "narrator",
      "text": "«هي اللي كتبت الاسم. لسه ماطرّزتوش.» صوتك طلع واطي.",
      "variants": [
        {
          "if": {
            "flag": "memory_stitch"
          },
          "text": "«هي. أنا ورّيتها أول حرفين، والباقي كانت هتكمّله.»"
        }
      ],
      "next": "g_keepsake"
    },
    {
      "id": "g_seam_nod",
      "type": "line",
      "speaker": "narrator",
      "text": "هزّيتي راسك. الأم فضلت بصّة للاسم، وانتي ماحاولتيش تملي السكوت.",
      "next": "g_keepsake"
    },
    {
      "id": "g_keepsake",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "keepsake_request",
            "eq": "drawing"
          },
          "goto": "g_ask_drawing"
        }
      ],
      "else": "g_handover"
    },
    {
      "id": "g_ask_drawing",
      "type": "line",
      "speaker": "mother",
      "text": "خليني أخدها دلوقتي. لسه ماشفتش كل حاجتها."
    },
    {
      "id": "g_handover",
      "type": "line",
      "speaker": "narrator",
      "text": "الأم لمّت الهدوم حوالين الكراسة، وسابت القفل مفتوح.",
      "effects": {
        "flags": {
          "mother_met": true
        }
      },
      "next": "final_handover"
    },
    {
      "id": "final_handover",
      "type": "choice",
      "prompt": "أم هدى مدت إيدها.",
      "options": [
        {
          "text": "(تناوليها الشنطة)",
          "goto": "final_bag",
          "effects": {
            "flags": {
              "last_action": "handover"
            },
            "vars": {}
          }
        },
        {
          "text": "«استني، الجواب فوق الهدوم.»",
          "goto": "final_letter",
          "if": {
            "flag": "letter_to_mother"
          },
          "effects": {
            "flags": {
              "last_action": "letter"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "final_bag",
      "type": "line",
      "text": "أخدتها بإيديها الاتنين. نعيمة فتحت لها الباب.",
      "speaker": "narrator",
      "cast": [
        "mother",
        "naima"
      ],
      "next": "g_after",
      "effects": {
        "flags": {
          "belongings_delivery": "mother",
          "mother_met": true
        }
      }
    },
    {
      "id": "final_letter",
      "type": "line",
