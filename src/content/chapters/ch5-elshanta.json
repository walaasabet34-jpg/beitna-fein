  "nodes": [
    {
      "id": "g_start",
      "type": "card",
      "title": "الفصل السادس",
      "subtitle": "الشنطة",
      "cast": [],
      "music": null,
      "broadcast": null
    },
    {
      "id": "g_burial",
      "type": "line",
      "speaker": "narrator",
      "text": "استنّوها لحد الضهر. دفنوها، ووصلت والناس راجعين، وشنطتها في إيدها. نعيمة راحت لها. إنتي ماقدرتيش تقربي.",
      "scene": "landing"
    },
    {
      "id": "g_home",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي كبايتين. رجعتي واحدة قبل ما تمليها.",
      "scene": "living"
    },
    {
      "id": "g_objects",
      "type": "choice",
      "prompt": "الطلبية قدامك. تبدأي بإيه؟",
      "options": [
        {
          "text": "(تقطعي ورقة النتيجة)",
          "goto": "g_cal",
          "effects": {
            "flags": {
              "tore_dec1": true
            }
          },
          "if": {
            "flag": "calendar_ritual"
          }
        },
        {
          "text": "(تطلّعي الكورة من تحت الماكينة)",
          "goto": "ball_alone",
          "if": {
            "any": [
              {
                "flag": "ball_games"
              },
              {
                "flag": "ball_stairs"
              }
            ]
          }
        },
        {
          "text": "(تفتحي علبة الزراير)",
          "goto": "g_buttons"
        },
        {
          "text": "(تفتحي الكراسة)",
          "goto": "g_notebook",
          "effects": {
            "flags": {
              "grief_opened_book": true
            }
          }
        },
        {
          "text": "(تسيبي كل حاجة مكانها النهارده)",
          "goto": "g_leave",
          "effects": {
            "flags": {
              "grief_left_room": true
            }
          }
        }
      ]
    },
    {
      "id": "ball_alone",
      "type": "activity",
      "activity": "ball",
      "params": {
        "variant": "alone",
        "rounds": 3
      }
    },
    {
      "id": "g_ball_after",
      "type": "line",
      "speaker": "narrator",
      "text": "الكورة وقفت تحت الماكينة. ماحدش قال الرقم.",
      "next": "g_war_memory",
      "variants": [
        {
          "if": {
            "flag": "ball_alone_caught"
          },
          "text": "مسكتيها. وقفتي مستنية حد يقول الرقم."
        },
        {
          "if": {
            "flag": "knows_high"
          },
          "text": "رميتيها عالي، زي ما كانت بتحب. نزلت ووقفت تحت الماكينة."
        }
      ]
    },
    {
      "id": "g_buttons",
      "type": "activity",
      "activity": "buttons",
      "params": {
        "order": "قميص ابن نعيمة",
        "helper": "none",
        "skill": 0,
        "redLine": "الزرار الأحمر اللي كانت بتحطه على جنب."
      }
    },
    {
      "id": "g_buttons_after",
      "type": "line",
      "speaker": "narrator",
      "text": "السلطانيتين اتملوا. الصينية ساكتة.",
      "next": "g_war_memory",
      "variants": [
        {
          "if": {
            "flag": "red_button",
            "eq": "hoda"
          },
          "text": "السلطانيتين اتملوا. الزرار الأحمر مش في العلبة؛ متخيّط على شريطتها."
        }
      ]
    },
    {
      "id": "g_notebook",
      "type": "line",
      "speaker": "narrator",
      "text": "في الكراسة إملا وحساب ورسم ناقص. في آخر صفحة أرقام بخطها: ٢، ٤، ٦، ٨…",
      "next": "g_war_memory"
    },
    {
      "id": "g_leave",
      "type": "line",
      "speaker": "narrator",
      "text": "سيبتي الحاجات مكانها. لما رجعتي للماكينة، الكراسة فضلت في طرف عينك.",
      "next": "g_war_memory"
    },
    {
      "id": "g_cal",
      "type": "line",
      "speaker": "narrator",
      "text": "قطعتي ورقة ٣٠ اللي ماحدش قطعها، وبعدين ١ ديسمبر. اليوم اللي كانت بتعدّ له. حطيتيهم في الكراسة.",
      "next": "g_war_memory"
    },
    {
      "id": "g_war_memory",
      "type": "line",
      "speaker": "narrator",
      "text": "الكراسة فضلت مكانها على طرف الترابيزة.",
      "variants": [
        {
          "if": {
            "flag": "war_shared_joy"
          },
          "text": "افتكرتي كفها في كفك يوم العبور."
        },
        {
          "if": {
            "flag": "war_return_promise"
          },
          "text": "افتكرتي يوم قلتي لها إن الرجوع قريب. سمعتي سؤالها تاني: قريب قد إيه؟"
        },
        {
          "if": {
            "flag": "war_silenced"
          },
          "text": "افتكرتي صوتك يوم العبور: «ثانية يا هدى، عايزة أسمع الباقي.» وعينها عليكي بعد ما سكتت."
        }
      ]
    },
    {
      "id": "g_contact",
      "type": "line",
      "speaker": "naima",
      "text": "عايزة حاجات بنتها، وعايزة تسمع منك. وبعد بكرة مسافرة الفيوم عند سنية.",
      "next": "g_meet",
      "lead": "تاني يوم، نعيمة: «أمها نامت عندي. المقاول ركّبها أول طيارة.»",
      "effects": {
        "setTime": {
          "day": 2,
          "slot": 0
        }
      },
      "scene": "door",
      "cast": [
        "naima"
      ]
    },
    {
      "id": "g_meet",
      "type": "choice",
      "prompt": "إنتي قادرة تقابليها؟",
      "options": [
        {
          "text": "«خليها تيجي. هقابلها.»",
          "goto": "g_yes",
          "effects": {
            "flags": {
              "mother_meeting": "now"
            },
            "vars": {}
          }
        },
        {
          "text": "«مش النهارده. بعد يومين، وهكون موجودة.»",
          "goto": "g_later",
          "effects": {
            "flags": {
              "mother_meeting": "later"
            },
            "vars": {}
          }
        },
        {
          "text": "«خدي إنتي الشنطة لها. مش قادرة أقابلها.»",
          "goto": "g_send",
          "effects": {
            "flags": {
              "mother_meeting": "messenger"
            },
            "vars": {}
          }
        },
        {
          "text": "«مش هقابلها، ومش هقدر أسلّم الحاجات دلوقتي.»",
          "goto": "g_refuse",
          "effects": {
            "flags": {
              "mother_meeting": "refused"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_yes",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي كرسي تاني جنب الطبلية، ورجعتي للشنطة.",
      "scene": "living",
      "cast": [],
      "next": "g_pack"
    },
    {
      "id": "g_later",
      "type": "line",
      "speaker": "narrator",
      "text": "«بعد يومين.» نعيمة نزلت تبلغها بالموعد.",
      "scene": "living",
      "cast": [],
      "next": "g_pack"
    },
    {
      "id": "g_send",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة فردت شالها، وحطت الشنطة جنبها تستنى تجهزيها.",
      "scene": "living",
      "cast": [
        "naima"
      ],
      "next": "g_pack"
    },
    {
      "id": "g_refuse",
      "type": "line",
      "speaker": "naima",
      "text": "«هقول لها إنك مش قادرة. بس هي مستنية حاجات بنتها.»",
      "scene": "living",
      "cast": [
        "naima"
      ],
      "next": "g_hold"
    },
    {
      "id": "g_hold",
      "type": "choice",
      "prompt": "بعد كلام نعيمة:",
      "options": [
        {
          "text": "تراجعي قرارك وتبعتي الحاجات معاها.",
          "goto": "g_send",
          "effects": {
            "flags": {
              "mother_meeting": "messenger",
              "grief_reconsidered": true
            },
            "vars": {}
          }
        },
        {
          "text": "تسمحي بالمقابلة، حتى لو مش عارفة هتقولي إيه.",
          "goto": "g_yes",
          "effects": {
            "flags": {
              "mother_meeting": "now",
              "grief_reconsidered": true
            },
            "vars": {}
          }
        },
        {
          "text": "تفضلي رافضة دلوقتي.",
          "goto": "g_hold_end",
          "effects": {
            "flags": {
              "belongings_delivery": "withheld"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_hold_end",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة خرجت من غير الشنطة. من الشباك، سمعتي صوت الباب اللي تحت.",
      "next": "final_keep",
      "cast": []
    },
    {
      "id": "final_keep",
      "type": "choice",
      "prompt": "الشنطة لسه عند الباب.",
      "options": [
        {
          "text": "(تسيبيها مكانها)",
          "goto": "final_keep_door",
          "effects": {
            "flags": {
              "last_action": "door"
            },
            "vars": {}
          }
        },
        {
          "text": "(تحطيها جنب الماكينة)",
          "goto": "final_keep_machine",
          "effects": {
            "flags": {
              "last_action": "machine"
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "final_keep_door",
      "type": "line",
      "text": "بعدتي إيدك عن القفل. طلب أمها لسه من غير رد.",
      "speaker": "narrator",
      "next": "g_end_hold"
    },
    {
      "id": "final_keep_machine",
      "type": "line",
      "text": "حرّكتيها عشان تعرفي تعدّي. مكانها ما وسّعش الأوضة.",
      "speaker": "narrator",
      "next": "g_end_hold"
    },
    {
      "id": "g_pack",
      "type": "activity",
      "activity": "dress",
      "params": {
        "mode": "pack",
        "captions": [
          {
            "item": "yellow",
            "if": {
              "flag": "cl_yellow",
              "eq": "flower"
            },
            "text": "الوردة الستان على الشق اللي من لعب الأولى."
          },
          {
            "item": "yellow",
            "if": {
              "flag": "cl_yellow",
              "eq": "mended"
            },
            "text": "الرقعة اللي تحت مش باينة غير لو دوّرتي عليها."
          },
          {
            "item": "yellow",
            "if": {
              "flag": "cl_yellow",
              "eq": "torn"
            },
            "text": "الشق اللي من لعب الأولى. ماتخيّطش."
          },
          {
            "item": "yellow",
            "text": "الفستان اللي جت بيه."
          },
          {
            "item": "navy",
            "if": {
              "flag": "cl_navy",
              "eq": "fitted"
            },
            "text": "الكم اللي قصّرتيه على قدّها."
          },
          {
            "item": "navy",
            "text": "المريلة، وكمّها الطويل."
          },
          {
            "item": "cardigan",
            "text": "الجاكتة اللي قالت إنها بتشوّك، ولبستها."
          },
          {
            "item": "comb",
            "text": "المشط أبو سنة مكسورة."
          },
          {
            "item": "notebook",
            "if": {
              "flag": "ball_last",
              "gte": 10
            },
            "text": "الكراسة الزرقا. في آخرها «عشرة» بخط كبير."
          },
          {
            "item": "notebook",
            "text": "الكراسة الزرقا."
          },
          {
            "item": "doll",
            "text": "زوزو، عينيها مش قد بعض."
          },
          {
            "item": "redButton",
            "text": "الزرار الأحمر، متخيّط على شريطة."
          },
          {
            "item": "ribbon",
            "if": {
              "flag": "ribbon",
              "eq": "red"
            },
            "text": "الشريطة الحمرا اللي لبستها يوم جواب أمها."
          },
          {
            "item": "ribbon",
            "text": "الشريطة الحمرا. كانت مستنية يوم مخصوص."
          },
          {
            "item": "ball",
            "text": "الكورة الشراب."
          }
        ]
      }
    },
    {
      "id": "g_prepare",
      "type": "choice",
      "prompt": "تجهزي الشنطة إزاي؟",
      "options": [
        {
          "text": "تحطي كل حاجتها؛ ماتحتفظيش بحاجة من غير سؤال.",
          "goto": "g_all",
          "effects": {
            "flags": {
              "keepsake_request": "none"
            },
            "vars": {}
          }
        },
        {
          "text": "تحطي كل حاجتها وتطلبي من الأم الاحتفاظ برسمة، لو وافقت.",
          "goto": "g_request",
          "effects": {
            "flags": {
              "keepsake_request": "drawing"
            },
            "vars": {}
          }
        },
        {
          "text": "تكتبي سطر عن كل حاجة تفتكريها، وتحطي الورقة مع الحاجات.",
          "goto": "g_note",
          "effects": {
            "flags": {
              "keepsake_request": "note",
              "memory_note": true
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "g_all",
      "type": "line",
      "speaker": "narrator",
      "text": "حطيتي المشط والهدوم والكراسة. كل مرة تفتكري إنك خلصتي، تلاقي حاجة صغيرة لسه برّه.",
      "next": "grief_letter"
    },
    {
      "id": "g_request",
      "type": "line",
      "speaker": "narrator",
      "text": "الرسمة دخلت الشنطة مع الباقي. كتبتي طلبك على ورقة؛ لو رفضت، هتفضل الرسمة معاها.",
      "next": "grief_letter"
    },
    {
      "id": "g_note",
      "type": "line",
      "speaker": "narrator",
      "text": "كتبتي اللي تقدري تقولي لها عن أيام هدى هنا. وقفتي عند سطر مش عارفة تكمّليه.",
      "next": "grief_letter"
    },
    {
      "id": "grief_letter",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "letter_to_mother"
          },
          "goto": "grief_letter_read"
        }
      ],
      "else": "g_seam"
    },
    {
      "id": "grief_letter_read",
      "type": "line",
      "text": "جواب هدى لأمها لسه مطبّق. حطيتيه فوق الهدوم؛ على الوش مكتوب: لماما.",
      "speaker": "narrator",
      "effects": {
        "flags": {
          "letter_delivered_with_bag": true
        },
        "vars": {}
      },
      "next": "g_seam"
    },
    {
      "id": "g_seam",
      "type": "line",
      "speaker": "narrator",
      "text": "جوه الشنطة اسمها بالقلم. أول مرة من زمان، قعدتي تبصي له من غير ما تدوري على حاجة تانية.",
      "variants": [
        {
          "if": {
            "flag": "memory_stitch"
          },
          "text": "أول حرفين بالخيط. الباقي بالقلم."
        },
        {
          "if": {
            "flag": "memory_refused"
          },
          "text": "الاسم كله بالقلم. الإبرة اللي طلبتها يومها كانت في درجك."
        }
      ]
    },
    {
      "id": "g_route",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "mother_meeting",
            "eq": "messenger"
          },
          "goto": "g_messenger"
        },
        {
          "if": {
            "flag": "mother_meeting",
            "eq": "later"
          },
          "goto": "g_dec12"
        }
      ],
      "else": "g_arrival"
    },
    {
      "id": "g_dec12",
      "type": "line",
      "speaker": "narrator",
      "text": "اليوم اللي حددتيه وصل. نعيمة خبطت على الباب.",
      "effects": {
        "setTime": {
          "day": 3,
          "slot": 0
        }
      },
      "next": "g_arrival"
    },
    {
      "id": "g_arrival",
      "type": "line",
      "speaker": "mother",
      "text": "«احكيلي عنها هنا. كانت بتعمل إيه؟»",
      "lead": "دخلت أم هدى ومعاها نعيمة. قالت اسم بنتها كله قبل ما تقعد.",
      "next": "g_relation",
      "scene": "living",
      "cast": [
        "mother",
        "naima"
      ],
      "music": null
    },
    {
      "id": "g_relation",
      "type": "line",
      "speaker": "narrator",
      "text": "أمها مستنية تسمع. صوت الماكينة في الشقة اللي جنبكم وقف.",
      "variants": [
        {
          "if": {
            "flag": "rehearsal"
          },
          "text": "افتكرتي هدى عند الباب: «إنتي تقفي هنا.» وقفتي جنب الباب."
        },
        {
          "if": {
            "flag": "relationship_before_illness",
            "eq": "warm"
          },
          "text": "أمها قرّبت كرسيها منك، واستنت تسمع."
        },
        {
          "if": {
            "flag": "relationship_before_illness",
            "eq": "closed"
          },
          "text": "حاولتي تفتكري حاجة كانت بتحب تعملها لوحدها. أمها فضلت مستنية."
        }
      ]
    },
    {
      "id": "g_account",
      "type": "choice",
      "prompt": "تختاري تحكي إزاي؟",
      "options": [
        {
          "text": "«كانت بتعدّ كل حاجة.»",
          "goto": "g_account_count",
          "effects": {
            "flags": {
              "mother_account": "count"
            }
          }
        },
        {
          "text": "«كانت بتدوّر على المشط كل شوية.»",
          "goto": "g_account_true",
          "effects": {
            "flags": {
              "mother_account": "truth"
            }
          }
        },
        {
          "text": "«كنت ساعات بصدّها لما تطلب مني حاجة…»",
          "goto": "g_account_fault",
          "effects": {
            "flags": {
              "mother_account": "admitted"
            }
          },
          "if": {
            "any": [
              {
                "flag": "memory_refused"
              },
              {
                "flag": "war_snap"
              },
              {
                "flag": "news_dismissed"
              },
              {
                "flag": "sew_denied"
              },
              {
                "flag": "ball_waiting"
              },
              {
                "all": [
                  {
                    "flag": "ball_promised"
                  },
                  {
                    "not": {
                      "flag": "ball_games"
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "text": "«فتحت شنطتها من غير إذنها.»",
          "goto": "g_account_bag",
          "effects": {
            "flags": {
              "mother_account": "admitted_bag"
            }
          },
          "if": {
            "any": [
              {
                "flag": "bag_peeked"
              },
              {
                "flag": "c2_peek"
              },
              {
                "flag": "c2_bag_opened"
              }
            ]
          }
        },
        {
          "text": "«كانت كويسة معايا.»",
          "goto": "g_account_hide",
          "effects": {
            "flags": {
              "mother_account": "evasive"
            }
          }
