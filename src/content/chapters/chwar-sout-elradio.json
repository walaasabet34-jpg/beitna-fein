    "money": 0,
    "scene": "living"
  },
  "slotNames": [
    "الصبح",
    "الضهر",
    "العصر",
    "المغرب",
    "بالليل"
  ],
  "dayNames": [
    "",
    "06/10",
    "07/10",
    "16/10",
    "22/10",
    "25/10"
  ],
  "calendar": {
    "1": "1973-10-06",
    "2": "1973-10-07",
    "3": "1973-10-16",
