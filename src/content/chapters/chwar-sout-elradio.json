  "calendarStatus": "provisional",
  "nodes": [
    {
      "id": "w_start",
      "type": "card",
      "title": "الفصل التاني",
      "subtitle": "صوت الراديو",
      "music": null,
      "cast": [
        "hoda"
      ],
      "broadcast": null,
      "effects": {
        "flags": {
          "cl_yellow": "clean"
        }
      }
    },
    {
      "id": "w_oct6",
      "type": "line",
      "speaker": "narrator",
      "text": "الفستان الأصفر اتغسل ونشف. هدى بتدوّر على مشطها، وطرف كراستها مغطّي نص الترابيزة."
    },
    {
      "id": "w_morning",
      "type": "choice",
      "prompt": "قبل ما ترجعي للماكينة:",
      "options": [
        {
          "text": "تساعديها تدور على المشط.",
          "goto": "w_comb",
          "effects": {
            "flags": {
              "war_comb": true
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "تقولي لها تدور بنفسها، وتفضّيلها مكان للشغل جنبك.",
          "goto": "w_space",
          "effects": {
            "flags": {
              "war_space": true
            },
            "vars": {
              "autonomy": 2
            }
          }
        },
        {
          "text": "«مش كل شوية تعطليني.»",
          "goto": "w_snap",
          "effects": {
            "flags": {
              "war_snap": true
            },
            "vars": {
              "trust": -3,
              "distress": 3
            }
          }
        }
      ]
    },
    {
      "id": "w_comb",
      "type": "line",
      "speaker": "narrator",
      "text": "طلع تحت الكراسة. مشّطت ضفيرتها بإيد وحاولت تقفل الكراسة بالتانية.",
      "next": "w_afternoon"
    },
    {
      "id": "w_space",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى لقت المشط، وحطت الكراسة على الطرف اللي فضّيتيه لها. صوت الورق فضل جنب صوت الماكينة.",
      "next": "w_afternoon"
    },
    {
      "id": "w_snap",
      "type": "line",
      "speaker": "narrator",
      "text": "«أنا بس بسأل.» رجعت تدور من غير ما تحرك الكرسي عشان ما يعملش صوت.",
      "next": "w_afternoon"
    },
    {
      "id": "w_afternoon",
      "type": "line",
      "speaker": "narrator",
      "text": "الخبر قطع شغلك. رفعتي رجلك من الدوّاسة وقرّبتي الكرسي للراديو.",
      "music": null,
      "effects": {
        "setTime": {
          "day": 1,
          "slot": 2
        }
      },
      "next": "war_listen"
    },
    {
      "id": "war_listen",
      "type": "choice",
      "prompt": "",
      "options": [
        {
          "text": "(ترفعّي صوت الراديو)",
          "goto": "war_tune",
          "effects": {
            "flags": {
              "war_listened": true
            },
            "vars": {}
          }
        },
        {
          "text": "(تفتحي الباب لنعيمة)",
          "goto": "war_door",
          "effects": {
            "flags": {
              "war_opened": true
            },
            "vars": {}
          }
        }
      ]
    },
    {
      "id": "war_tune",
      "type": "line",
      "text": "هدى سحبت كرسيّها قريب. سيبتي الصوت واضح.",
      "speaker": "narrator",
      "next": "w_radio"
    },
    {
      "id": "war_door",
      "type": "line",
      "text": "نعيمة كانت على الباب فعلًا، ومن الشقة اللي جنبها صوت زغرودة.",
      "speaker": "narrator",
      "scene": "door",
      "cast": [
        "hoda",
        "naima"
      ],
      "next": "w_radio"
    },
    {
      "id": "w_radio",
      "type": "line",
      "speaker": "narrator",
      "text": "من الراديو سمعتي إن قواتنا عبرت قناة السويس. نعيمة عند الباب بتقول: «عبروا يا فاطمة!»",
      "cast": [
        "hoda",
        "naima"
      ],
      "scene": "living"
    },
    {
      "id": "w_hoda",
      "type": "line",
      "speaker": "hoda",
      "text": "يعني الناحية التانية؟",
      "expr": "surprised"
    },
    {
      "id": "w_celebrate",
      "type": "choice",
      "prompt": "الخبر مفرّح. تردّي عليها إزاي؟",
      "options": [
        {
          "text": "(تقربي الكرسي لهدى) «تعالي اسمعي معايا.»",
          "goto": "w_joy",
          "effects": {
            "flags": {
              "war_shared_joy": true
            },
            "vars": {
              "trust": 3,
              "safety": 2
            }
          }
        },
        {
          "text": "«هنرجع قريب، خلاص.»",
          "goto": "w_promise",
          "effects": {
            "flags": {
              "war_return_promise": true
            },
            "vars": {}
          }
        },
        {
          "text": "«ثانية يا هدى، عايزة أسمع الباقي.»",
          "goto": "w_quiet",
          "effects": {
            "flags": {
              "war_silenced": true
            },
            "vars": {
              "openness": -3
            }
          }
        }
      ]
    },
    {
      "id": "w_joy",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة زغردت. هدى خبطت كفها في كفك، وبعدين جريت تبص من الشباك.",
      "next": "w_flag"
    },
    {
      "id": "w_promise",
      "type": "line",
      "speaker": "narrator",
      "text": "«قريب قد إيه؟» ماعرفتيش تردي. هدى راحت تشوف الفستان اللي جوه الشنطة، قبل ما نعيمة تناديها تفرح معاكم.",
      "next": "w_flag"
    },
    {
      "id": "w_quiet",
      "type": "line",
      "speaker": "narrator",
      "text": "سكتت. نعيمة قعدت جنبها وقالتلها إن الجيش عبر القناة. هدى ابتسمت لها، وفضلت عينها عليكي.",
      "next": "w_flag"
    },
    {
      "id": "w_flag",
      "type": "choice",
      "prompt": "هدى رسمت علم صغير في كراستها. عايزة تعملوا إيه بيه؟",
      "options": [
        {
          "text": "تكتبوا التاريخ واسمها وتحطوه جنب الراديو.",
          "goto": "w_flag_keep",
          "effects": {
            "flags": {
              "war_flag_kept": true
            },
            "vars": {
              "safety": 2
            }
          }
        },
        {
          "text": "تسيبيه في كراستها وتحكي معاها عن الرسم.",
          "goto": "w_flag_book",
          "effects": {
            "flags": {
              "war_flag_book": true
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "تطلبّي منها تلم الورق. الطلبية لازم تخلص.",
          "goto": "w_flag_put",
          "effects": {
            "flags": {
              "war_flag_dismissed": true
            },
            "vars": {
              "openness": -2
            }
          }
        }
      ]
    },
    {
      "id": "w_flag_keep",
      "type": "line",
      "speaker": "narrator",
      "text": "كتبت «٦ أكتوبر» تحت العلم. قلمها ضغط في الورقة، وانتي ثبّتّيها بعيد عن سخونة الراديو.",
      "next": "w_cross"
    },
    {
      "id": "w_flag_book",
      "type": "line",
      "speaker": "narrator",
      "text": "«السارية طلعت مايلة.» قلتي لها: «جرّبي بالمِسطرة.» سابته في الكراسة بعد ما عدّلته.",
      "next": "w_cross"
    },
    {
      "id": "w_flag_put",
      "type": "line",
      "speaker": "narrator",
      "text": "قفلت الكراسة. إنتي رجعتي للشغل، ومن الشباك لسه واصل صوت الناس.",
      "next": "w_cross"
    },
    {
      "id": "w_cross",
      "type": "line",
      "speaker": "hoda",
      "text": "نلعب عبور؟ الطبلية هي القناة، والكورة لازم تعدّي من فوق!",
      "expr": "laugh"
    },
    {
      "id": "w_cross_c",
      "type": "choice",
      "options": [
        {
          "text": "«يلا. بس من فوق الطبلية.»",
          "goto": "ball_crossing"
        },
        {
          "text": "«بعد النشرة.»",
          "goto": "w_cross_no",
          "effects": {
            "flags": {
              "war_cross_later": true
            }
          }
        }
      ]
    },
    {
      "id": "ball_crossing",
      "type": "activity",
      "activity": "ball",
      "params": {
        "variant": "crossing",
        "rounds": 5,
        "effects": {
          "vars": {
            "trust": 2,
            "safety": 2,
            "distress": -3
          }
        }
      }
    },
    {
      "id": "w_cross_after",
      "type": "line",
      "speaker": "hoda",
      "text": "الساتر وقع!",
      "next": "w_oct7",
      "variants": [
        {
          "if": {
            "flag": "ball_stopped"
          },
          "text": "خلاص؟ ماشي. بكرة نعبر تاني.",
          "expr": "neutral"
        },
        {
          "if": {
            "flag": "ball_last",
            "gte": 4
          },
          "text": "عبرنا أربع مرات! نعيمة، شفتي؟",
          "expr": "proud"
        }
      ],
      "expr": "laugh"
    },
    {
      "id": "w_cross_no",
      "type": "line",
      "speaker": "narrator",
      "text": "خبّطت الكورة في الحيطة مرتين، وبعدين قعدت تلوّن العلم.",
      "next": "w_oct7"
    },
    {
      "id": "w_oct7",
      "type": "line",
      "speaker": "narrator",
      "text": "تاني يوم الصبح، نعيمة نادت من الباب: «ابني رجع من عند عم فوزي.»",
      "cast": [
        "hoda",
        "naima"
      ],
      "effects": {
        "setTime": {
          "day": 2,
          "slot": 0
        }
      }
    },
    {
      "id": "w_search",
      "type": "line",
      "speaker": "naima",
      "text": "أمها سابت المحل في الربيع، واشتغلت في مصنع ملابس في إسكندرية. عنوانها ماعندوش.",
      "effects": {
        "flags": {
          "search_fawzi": true
        }
      }
    },
    {
      "id": "w_address",
      "type": "choice",
      "options": [
        {
          "text": "«نكتب لها على المصنع، باسمها.»",
          "goto": "w_details",
          "effects": {
            "flags": {
              "search_details": true
            },
            "vars": {
              "trust": 1
            }
          }
        },
        {
          "text": "«هدى، إنتي فاكرة حاجة عن المصنع؟»",
          "goto": "w_naima",
          "effects": {
            "flags": {
              "search_asked_hoda": true
            },
            "vars": {
              "openness": 2
            }
          }
        },
        {
          "text": "«وحاجة سنية؟ صاحب البيت شايلها؟»",
          "goto": "w_later",
          "effects": {
            "flags": {
              "search_landlord": true
            }
          }
        }
      ],
      "prompt": "الخطوة الجاية:"
    },
    {
      "id": "w_details",
      "type": "line",
      "speaker": "narrator",
      "text": "كتبتي على الظرف اسمها، و«مسنع الملابس، إسكندرية». هدى مدّت صباعها: «مصنع بالصاد يا خالتي.»",
      "next": "w_letter_send",
      "effects": {
        "flags": {
          "hoda_corrected_fatma": true
        }
      }
    },
    {
      "id": "w_naima",
      "type": "line",
      "speaker": "hoda",
      "text": "كانت بتقول «المصنع اللي جنبه الترعة». وبتيجي بالقطر، وتجيبلي جوافة.",
      "next": "w_letter_send",
      "expr": "neutral"
    },
    {
      "id": "w_later",
      "type": "line",
      "speaker": "naima",
      "text": "شايلها في المخزن. هيطلّعها لما يلاقي مفتاحه. وكمان نكتب على المصنع، مش هنخسر حاجة.",
      "next": "w_letter_send"
    },
    {
      "id": "w_letter_send",
      "type": "line",
      "speaker": "narrator",
      "text": "ابن نعيمة خد الجواب للبوستة: اسمها، والمصنع، وإسكندرية. هدى كتبت تحت: «أنا كويسة».",
      "effects": {
        "flags": {
          "search_factory_letter": true
        }
      }
    },
    {
      "id": "w_oct16",
      "type": "line",
      "speaker": "narrator",
      "text": "الأخبار متفرقة. قوات إسرائيلية بقت غرب القناة، وإنتي بتحاولي تفهمي من النشرة.",
      "effects": {
        "setTime": {
          "day": 3,
          "slot": 3
        }
      },
      "cast": [
        "hoda"
      ],
      "scene": "living"
    },
    {
      "id": "w_worry",
      "type": "line",
      "speaker": "hoda",
      "text": "بس إحنا فرحنا."
    },
    {
      "id": "w_worry_choice",
      "type": "choice",
      "prompt": "تقوليلها إيه؟",
      "options": [
        {
          "text": "«أيوه. ولسه فيه قتال.»",
          "goto": "w_truth",
          "effects": {
            "flags": {
              "war_uncertainty_honest": true
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "«هقولك لما أفهم.»",
          "goto": "w_block",
          "effects": {
            "flags": {
              "war_blocked": true
            },
            "vars": {
              "openness": -3
            }
          }
        }
      ]
    },
    {
      "id": "w_truth",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى قعدت جنبك. سابت النشرة تكمل، وبعدين سألت إذا كان ينفع تسيب النور شوية.",
      "next": "w_oct22"
    },
    {
      "id": "w_block",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى قفلت الكراسة وسندت القلم فوقها. وإنتي لقيتي نفسك بتدوّري على نشرة تانية.",
      "next": "w_oct22"
    },
    {
      "id": "w_oct22",
      "type": "line",
      "speaker": "narrator",
      "text": "النشرة جابت خبر الدعوة لوقف إطلاق النار. وبعدها نعيمة طلعت ومعاها علبة صفيح: حاجة سنية من عند صاحب البيت.",
      "cast": [
        "hoda",
        "naima"
      ],
      "effects": {
        "setTime": {
          "day": 4,
          "slot": 3
        },
        "flags": {
          "search_box": true
        }
      }
    },
    {
      "id": "w_box",
      "type": "line",
      "speaker": "narrator",
      "text": "جوه العلبة جوابات بخط واحد. آخر جواب لسه مقفول، وعليه اسم سنية."
    },
    {
      "id": "w_box_naima",
      "type": "line",
      "speaker": "naima",
      "text": "اقري إنتي يا فاطمة. أنا مابعرفش أقرا."
    },
    {
      "id": "w_box_c",
      "type": "choice",
      "options": [
        {
          "text": "«اقريه إنتي يا هدى.»",
          "goto": "w_read_hoda",
          "effects": {
            "flags": {
              "mother_letter_read": "hoda"
            },
            "vars": {
              "trust": 2,
              "openness": 2
            }
          }
        },
        {
          "text": "(تفتحيه وتقريه بصوت عالي)",
          "goto": "w_read_fatma",
          "effects": {
            "flags": {
              "mother_letter_read": "fatma"
            },
            "vars": {
              "safety": 1
            }
          }
        },
        {
          "text": "«خدي هدى تحت يا نعيمة. أقراه الأول.»",
          "goto": "w_read_first",
          "effects": {
            "flags": {
              "mother_letter_read": "first"
            },
            "vars": {
              "autonomy": -2,
              "distress": 2
            }
          }
        }
      ]
    },
    {
      "id": "w_read_hoda",
      "type": "line",
      "speaker": "hoda",
      "text": "ده خط ماما. هي بتكتب الزاي بنقطة كبيرة كده.",
      "next": "w_letter",
      "expr": "smile"
    },
    {
      "id": "w_read_fatma",
      "type": "line",
      "speaker": "narrator",
      "text": "قريتيه على مهلك، كلمة كلمة. عند كلمة «ورديتين» وقفتي، وهدى قالتها قبلك.",
      "next": "w_letter"
    },
    {
      "id": "w_read_first",
      "type": "line",
      "speaker": "narrator",
      "text": "قريتيه لوحدك جنب الشباك. لما هدى طلعت، عينها كانت على العلبة: «ده جواب ماما؟»",
      "next": "w_letter"
    },
    {
      "id": "w_letter",
      "type": "line",
      "speaker": "narrator",
      "text": "«يا سنية، المصنع شغال ورديتين والإجازات واقفة. لقيت أوضة مع اتنين زمايلي، وأول ما أقبض هاجي آخد هدى. بوسيها. — زينب»",
      "scene": "paper",
      "cast": [],
      "effects": {
        "flags": {
          "mother_reason_known": true
        }
      }
    },
    {
      "id": "w_hostel",
      "type": "line",
      "speaker": "narrator",
      "text": "على ضهر الظرف: «سكن العاملات، مصنع الملابس». أول عنوان بجد.",
      "scene": "living",
      "cast": [
        "hoda",
        "naima"
      ],
      "effects": {
        "flags": {
          "search_hostel_address": true
        }
      }
    },
    {
      "id": "w_reply_c",
      "type": "choice",
      "options": [
        {
          "text": "«اكتبي إنتي، وأنا أمسك الورقة.»",
          "goto": "w_reply_hoda",
          "effects": {
            "flags": {
              "hostel_letter_by": "hoda"
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "«أنا أكتب، وإنتي تكتبي اسمك تحت.»",
          "goto": "w_reply_fatma",
          "effects": {
            "flags": {
              "hostel_letter_by": "fatma"
            }
          }
        }
      ],
      "prompt": "الرد على سكن العاملات:"
    },
    {
      "id": "w_reply_hoda",
      "type": "line",
      "speaker": "hoda",
      "text": "اكتبي… لأ، أنا هكتب: «أنا عند خالتي فاطمة، وبعدّ السلالم هنا كمان. سبعة وتمانين.»",
      "next": "w_reply_sent",
      "expr": "focused"
    },
    {
      "id": "w_reply_fatma",
      "type": "line",
      "speaker": "narrator",
      "text": "كتبتي عنوانك بخط كبير، وهي كتبت اسمها، وتحته رسمت كورة صغيرة.",
      "next": "w_reply_sent"
    },
    {
      "id": "w_reply_sent",
      "type": "line",
      "speaker": "narrator",
