    {
      "id": "s_stitch",
      "type": "choice",
      "prompt": "«كتبت اسمي بالقلم على حتة قماش. تورّيني أطرّزه قبل ما ماما تيجي؟»",
      "options": [
        {
          "text": "توقفي خمس دقايق وتوريها أول حرفين.",
          "goto": "s_help",
          "effects": {
            "flags": {
              "memory_stitch": true
            },
            "vars": {
              "trust": 3,
              "safety": 2
            }
          }
        },
        {
          "text": "تحددي لها وقت بعد الطلبية، وتلتزمي بيه.",
          "goto": "s_later",
          "effects": {
            "flags": {
              "memory_stitch": true,
              "memory_kept_time": true
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "«سيبي الإبرة. مش ناقصة شغل يتعاد.»",
          "goto": "s_refuse",
          "effects": {
            "flags": {
              "memory_refused": true
            },
            "vars": {
              "trust": -3,
              "openness": -3
            }
          }
        }
      ]
    },
    {
      "id": "s_help",
      "type": "line",
      "speaker": "narrator",
      "text": "مسكتي القماش، وهي شدّت الخيط. أول حرفين طلعوا عوج، والباقي فضل بالقلم.",
      "next": "s_hub",
      "effects": {
        "setTime": {
          "day": 1,
          "slot": 2
        }
      }
    },
    {
      "id": "s_later",
      "type": "line",
      "speaker": "narrator",
      "text": "بعد تسليم الطلبية ندهتيلها بنفسك. سألتك: «لسه فاكرة؟» قعدتوا تعملوا أول حرفين، وسابت الباقي بالقلم.",
      "next": "s_hub",
      "effects": {
        "setTime": {
          "day": 1,
          "slot": 2
        }
      }
    },
    {
      "id": "s_refuse",
      "type": "line",
      "speaker": "narrator",
      "text": "حطت الإبرة بعيد. الاسم فضل كله بالقلم. قفلت الشنطة ورجعت للكراسة.",
      "next": "s_hub",
      "effects": {
        "setTime": {
          "day": 1,
          "slot": 2
        }
      }
    },
