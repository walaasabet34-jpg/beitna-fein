  "_notes": {
    "history": "تواريخ الفصل مؤقتة. الحوالة البريدية والطوابع لليبيا تفاصيل معقولة، مش مصدر رسمي.",
    "continuity": "يعتمد على متغيرات الثقة والأمان والتوتر الموجودة بالفعل."
  },
  "nodes": [
    {
      "id": "c3_start",
      "type": "card",
      "title": "الفصل الرابع",
      "subtitle": "الخبر",
      "sfx": "page",
      "music": null,
      "effects": {
        "flags": {
          "c3_note_checked": false,
          "c3_bag_place": "unknown"
        }
      }
    },
    {
      "id": "c3_a1",
      "type": "line",
      "speaker": "narrator",
      "text": "العصر. هدى رجعت من المدرسة، والخيط خلص والطلبية في نصها.",
      "scene": "living",
      "cast": [
        "hoda"
      ],
      "effects": {
        "flags": {
          "thread": 0
        }
      }
    },
    {
      "id": "c3_thread",
      "type": "choice",
      "options": [
        {
          "text": "تنزلي تجيبي بكرة من الخردواتي.",
          "goto": "c3_buy",
          "effects": {
            "money": -2,
            "flags": {
              "thread": 1,
              "thread_bought": true
            }
          },
          "if": {
            "money": {
              "gte": 2
            }
          }
        },
        {
          "text": "تطلبي بكرة من نعيمة لحد ما تقبضي.",
          "goto": "c3_borrow",
          "effects": {
            "flags": {
              "thread": 1,
              "thread_borrowed": true
            }
          }
        },
        {
          "text": "تفكّي خيط من فستان قديم مقطوع.",
          "goto": "c3_unpick",
          "effects": {
            "slots": 1,
            "flags": {
              "thread": 1,
              "thread_unpicked": true
            }
          }
        }
      ],
      "prompt": "الخيط:"
    },
    {
      "id": "c3_buy",
      "type": "line",
      "speaker": "narrator",
      "text": "نزلتي. الخردواتي لفّ البكرة في ورقة جرنال.",
      "next": "c3_a4"
    },
    {
      "id": "c3_borrow",
      "type": "line",
      "speaker": "narrator",
      "text": "نعيمة ادّتك بكرة، وطلّعت من صدرها جواب: «ده من ابني اللي في الجيش. اقريهولي.» قريتيه لها مرتين.",
      "cast": [
        "naima"
      ],
      "scene": "door",
      "effects": {
        "flags": {
          "read_for_naima": true
        }
      },
      "next": "c3_a4"
    },
    {
      "id": "c3_unpick",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى قعدت تفك معاكي. كل ما الخيط يطول، تقول رقمه: «تلاتين… واحد وتلاتين…»",
      "effects": {
        "vars": {
          "trust": 1
        }
      },
      "next": "c3_a4"
    },
    {
      "id": "c3_a4",
      "type": "line",
      "speaker": "hoda",
      "text": "ده من ليبيا! ده خط ماما!",
      "scene": "door",
      "lead": "البواب من تحت: «جواب يا ست فاطمة! طوابع غريبة.»",
      "effects": {
        "flags": {
          "mother_contacted": true,
          "search_supervisor_reply": true
        }
      },
      "expr": "surprised"
    },
    {
      "id": "c3_paper",
      "type": "choice",
      "options": [
        {
          "text": "«افتحيه إنتي يا هدى. ده بتاعك.»",
          "goto": "c3_ask",
          "effects": {
            "flags": {
              "reply_read_by": "hoda"
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "(تقريه بصوت عالي، وهي لازقة فيكي)",
          "goto": "c3_keep",
          "effects": {
            "flags": {
              "reply_read_by": "fatma"
            },
            "vars": {
              "safety": 1
            }
          }
        }
      ]
    },
    {
      "id": "c3_ask",
      "type": "line",
      "speaker": "narrator",
      "text": "فتحته بصوابع بتترعش. قرت أول سطر بصوت عالي، وبعدين ادّتهولك: «كمّلي إنتي.»",
      "next": "clue_compare",
      "scene": "living"
    },
    {
      "id": "c3_keep",
      "type": "line",
      "speaker": "narrator",
      "text": "قريتي على مهلك. هدى بتسبقك بكلمة كل شوية، وصباعها على السطر.",
      "scene": "living"
    },
    {
      "id": "clue_compare",
      "type": "line",
      "speaker": "narrator",
      "text": "«يا هدى يا نور عيني. عدّي السلالم لحد ما آجي، وأنا أطلعهم معاكي.»",
      "scene": "paper",
      "variants": [
        {
          "if": {
            "flag": "proof_detail",
            "eq": "egg"
          },
          "text": "«يا هدى يا نور عيني. لسه مابتحبيش البيض المسلوق؟ ضحّكتيني وعيّطتيني في نفس الوقت.»"
        },
        {
          "if": {
            "flag": "proof_detail",
            "eq": "ball"
          },
          "text": "«يا هدى يا نور عيني. الكورة اللي رسمتيها لسه فيها الخياطة الحمرا؟ خلّي بالك منها لحد ما آجي.»"
        },
        {
          "if": {
            "flag": "proof_detail",
            "eq": "cat"
          },
          "text": "«يا هدى يا نور عيني. مشمش؟ إنتي لسه فاكراها! لما آجي ندوّر لك على قطة في الشارع الجديد.»"
        },
        {
          "if": {
            "flag": "proof_detail",
            "eq": "sky"
          },
          "text": "«يا هدى يا نور عيني. الإزاز الأزرق؟ أنا كمان بشوف السما من شباك الورشة وأفتكرك.»"
        }
      ]
    },
    {
      "id": "c3_history",
      "type": "line",
      "speaker": "narrator",
      "text": "«جوابينكم وصلوني سوا أول الشهر. ألف سلامة على سنية. العقد يخلص آخر نوفمبر، ولو سبته قبلها أخسر التذكرة وفلوس الشهور. أول ديسمبر أكون عندك. ابعتوا على الورشة؛ العنوان ورا الظرف. ست فاطمة، ربنا يخليكي. — ماما»",
      "scene": "paper"
    },
    {
      "id": "c3_notice",
      "type": "line",
      "speaker": "hoda",
      "text": "هي فاكرة! …طب ليه ماتجيش دلوقتي؟ ما هي عرفت.",
      "scene": "living",
      "expr": "worried"
    },
    {
      "id": "c3_truth",
      "type": "choice",
      "options": [
        {
          "text": "«لو سابت الشغل قبل ما يخلص، تخسر التذكرة وفلوس شهور. هي هناك عشان تأجر لكم أوضة.»",
          "goto": "c3_truth_yes",
          "effects": {
            "vars": {
              "trust": 3,
              "openness": 2
            },
            "flags": {
              "c3_why": "truth"
            }
          }
        },
        {
          "text": "(تقربيها من النتيجة) «نعدّ اللي فاضل سوا.»",
          "goto": "c3_truth_later",
          "effects": {
            "vars": {
              "trust": 2,
              "safety": 2
            },
            "flags": {
              "c3_why": "count"
            }
          }
        },
        {
          "text": "«الكبار عندهم حسابات.»",
          "goto": "c3_truth_no",
          "effects": {
            "vars": {
              "openness": -2,
              "distress": 2
            },
            "flags": {
              "c3_why": "short"
            }
          }
        }
      ]
    },
    {
      "id": "c3_truth_yes",
      "type": "line",
      "speaker": "hoda",
      "text": "يعني هي بتشتغل عشاني. زي ما إنتي بتشتغلي على الماكينة.",
      "next": "c3_money",
      "expr": "sad"
    },
    {
      "id": "c3_truth_later",
      "type": "line",
      "speaker": "hoda",
      "text": "واحد وعشرين. صوابع إيديا ورجليا… وواحد زيادة.",
      "next": "c3_money",
      "expr": "laugh"
    },
    {
      "id": "c3_truth_no",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى طبّقت الجواب ورجّعته في الظرف، من غير ما تسأل تاني.",
      "next": "c3_money"
    },
    {
      "id": "c3_money",
      "type": "choice",
      "options": [
        {
          "text": "«الخمسين قرش دول بتوعك يا هدى. نحطهم في ظرف ليكي.»",
          "goto": "c3_money_hoda",
          "effects": {
            "flags": {
              "mother_money": "hoda"
            },
            "vars": {
              "autonomy": 3,
              "trust": 1
            }
          }
        },
        {
          "text": "«نحطهم في علبة الصفيح، للأكل والجزمة الشتوي.»",
          "goto": "c3_money_tin",
          "effects": {
            "flags": {
              "mother_money": "tin"
            },
            "money": 50
          }
        }
      ],
      "prompt": "وفي الظرف حوالة بخمسين قرش لهدى. محمود هيصرفها من البوستة."
    },
    {
      "id": "c3_money_hoda",
      "type": "line",
      "speaker": "hoda",
      "text": "بتوعي أنا؟ …هفكّر هشتري إيه. حاجة مهمة.",
      "next": "c3_bag1",
      "expr": "proud"
    },
    {
      "id": "c3_money_tin",
      "type": "line",
      "speaker": "narrator",
      "text": "علبة الصفيح تقلت. أول مرة من شهور تسمعي فيها صوت فلوس كتير. هدى قالت: «ماما بتساعدك.»",
      "next": "c3_bag1"
    },
    {
      "id": "c3_bag1",
      "type": "line",
      "speaker": "fatma",
      "text": "بتعملي إيه يا هدى؟",
      "lead": "المغرب. هدى بتطبّق الفستان الأصفر في الشنطة، والجواب جنبها.",
      "next": "c3_bag3",
      "effects": {
        "setTime": {
          "slot": 3
        }
      },
      "scene": "living",
      "cast": [
        "hoda"
      ],
      "music": null
    },
    {
      "id": "c3_bag3",
      "type": "line",
      "speaker": "hoda",
      "text": "برتب حاجتي.",
      "expr": "guarded"
    },
    {
      "id": "c3_bag4",
      "type": "line",
      "speaker": "fatma",
      "text": "ليه؟"
    },
    {
      "id": "c3_bag5",
      "type": "line",
      "speaker": "hoda",
      "text": "عشان لما ماما تيجي أبقى جاهزة. لما مشينا من السويس ما لحقتش آخد كل حاجتي.",
      "expr": "sad"
    },
    {
      "id": "c3_bag_history",
      "type": "branch",
      "cases": [
        {
          "if": {
            "flag": "bag_promise"
          },
          "goto": "c3_bag_promise"
        }
      ],
      "else": "c3_bag_choice"
    },
    {
      "id": "c3_bag_promise",
      "type": "line",
      "speaker": "narrator",
      "text": "افتكرتي وعدك القديم إن محدش يلمس شنطتها من غير إذنها. المرة دي هي اللي فتحتها.",
      "next": "c3_bag_choice"
    },
    {
      "id": "c3_bag_choice",
      "type": "choice",
      "prompt": "تعملي إيه؟",
      "options": [
        {
          "text": "«سيبيها مفتوحة. لسه هتحتاجي هدومك تلات أسابيع.»",
          "goto": "c3_bag_open",
          "effects": {
            "vars": {
              "trust": 2,
              "openness": 2
            },
            "flags": {
              "c3_bag_response": "open"
            }
          }
        },
        {
          "text": "«حاجتك مكانها هنا، ومحدش هيستعجلك.»",
          "goto": "c3_bag_home",
          "effects": {
            "vars": {
              "safety": 4,
              "trust": 2
            },
            "flags": {
              "c3_bag_response": "home"
            }
          }
        },
        {
          "text": "«بس إنتي لسه قاعدة معايا، مش كده؟»",
          "goto": "c3_bag_fear",
          "effects": {
            "vars": {
              "distress": 4,
              "safety": -2
            },
            "flags": {
              "c3_bag_response": "fear"
            }
          }
        }
      ]
    },
    {
      "id": "c3_bag_open",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى سابت الفستان على ركبتها. «يعني أقفلها يوم تلاتين؟» قلتي: «يوم تلاتين.»",
      "next": "c3_question"
    },
    {
      "id": "c3_bag_home",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى بصت للدولاب وبعدين للشنطة. «حتى لو فضلت مستنية؟» قلتي: «حتى لو.»",
      "next": "c3_question"
    },
    {
      "id": "c3_bag_fear",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى سابت الفستان من إيدها. «أنا مش ماشية دلوقتي يا خالتي.»",
      "next": "c3_question"
    },
    {
      "id": "c3_question",
      "type": "line",
      "speaker": "hoda",
      "text": "لما ماما تيجي… هتزعلي إني أمشي؟",
      "expr": "worried"
    },
    {
      "id": "c3_answer",
      "type": "choice",
      "prompt": "تجاوبي إزاي؟",
      "options": [
        {
          "text": "«هتوحشيني طبعًا. بس هاجي أزورك.»",
          "goto": "c3_answer_honest",
          "effects": {
            "vars": {
              "trust": 3,
              "safety": 3,
              "openness": 2
            },
            "flags": {
              "c3_answer": "honest"
            }
          }
        },
        {
          "text": "«هتبقي مع ماما يا هدى.»",
          "goto": "c3_answer_soft",
          "effects": {
            "vars": {
              "safety": 2
            },
            "flags": {
              "c3_answer": "soft"
            }
          }
        },
        {
          "text": "«ما تفكريش في الكلام ده دلوقتي.»",
          "goto": "c3_answer_avoid",
          "effects": {
            "vars": {
              "distress": 3,
              "openness": -2
            },
            "flags": {
              "c3_answer": "avoid"
            }
          }
        }
      ]
    },
    {
      "id": "c3_answer_honest",
      "type": "line",
      "speaker": "hoda",
      "text": "طب تيجي معانا أول يوم في الأوضة الجديدة؟",
      "next": "c3_night"
    },
    {
      "id": "c3_answer_soft",
      "type": "line",
      "speaker": "narrator",
      "text": "هدى هزت راسها، لكن فضلت ماسكة المشط كأنها مستنية بقية الجملة.",
      "next": "c3_night"
    },
    {
      "id": "c3_answer_avoid",
      "type": "line",
      "speaker": "narrator",
      "text": "«ماشي.» قالتها وهي بتقفل طرف الشنطة، من غير ما تقفل القفل.",
      "next": "c3_night"
    },
    {
      "id": "c3_night",
      "type": "line",
      "speaker": "narrator",
      "text": "بالليل، جواب ماما تحت مخدة هدى، وطرفه باين.",
      "scene": "living",
      "cast": [],
      "music": "music_night",
      "effects": {
        "setTime": {
          "slot": 4
        }
      }
    },
    {
      "id": "c3_day2",
      "type": "activity",
      "activity": "comb",
      "params": {
        "strokes": 6,
        "special": true,
        "effects": {
          "flags": {
