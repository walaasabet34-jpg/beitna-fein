    {
      "id": "c3_truth",
      "type": "choice",
      "prompt": "تردّي عليها بإيه؟",
      "options": [
        {
          "text": "«جالنا رد. مش ماما، بس عرفنا إنها سابت السكن ولسه في المصنع.»",
          "goto": "c3_truth_yes",
          "effects": {
            "vars": {
