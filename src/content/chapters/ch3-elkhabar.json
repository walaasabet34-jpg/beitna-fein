        {
          "text": "«جه رد، وهكتب تاني الأول. وبعدين أحكيلك.»",
          "goto": "c3_truth_later",
          "effects": {
            "vars": {
              "trust": 1,
              "distress": 1
            },
            "flags": {
              "c3_told": "partial"
