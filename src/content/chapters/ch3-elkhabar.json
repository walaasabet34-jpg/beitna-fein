          }
        },
        "lines": [
          "النهارده الشريطة الحمرا. عشان جواب ماما.",
          "هكتب لها إن الأبلة قالتلي برافو في الإملا.",
          "ماما هتضفّرني يوم واحد ديسمبر. وإنتي تتفرجي."
        ]
      },
      "scene": "morning",
      "music": null,
      "effects": {
        "setTime": {
          "day": 2,
          "slot": 0
        },
        "vars": {
          "trust": 1
        }
      }
    },
    {
      "id": "c3_check_w",
      "type": "line",
      "speaker": "fatma",
      "text": "نرد على الورشة قبل المدرسة؟"
    },
    {
      "id": "c3_check",
      "type": "choice",
      "options": [
        {
          "text": "«اكتبي إنتي. هاتي الورقة وأنا أمسكها.»",
          "goto": "c3_check_careful",
          "effects": {
            "flags": {
              "letter_started": true
            },
            "vars": {
              "trust": 2
            }
          }
        },
        {
          "text": "«قوليلي إنتي، وأنا أكتب.»",
          "goto": "c3_check_name",
          "effects": {
            "flags": {
              "letter_dictated": true
            }
          }
        },
        {
          "text": "«نكتبه بالليل، بعد الطلبية.»",
          "goto": "c3_check_home",
          "effects": {
            "flags": {
              "letter_delayed": true
            }
          }
        }
      ]
    },
    {
      "id": "c3_check_careful",
      "type": "line",
      "speaker": "narrator",
      "text": "عند «الإجازة» وقفت: «بالألف ولا بالهمزة؟» وصحّحتها لنفسها. وكتبت تحت: «فاضل عشرين.»",
      "next": "c3_return"
    },
    {
      "id": "c3_check_name",
      "type": "line",
      "speaker": "narrator",
      "text": "قالت الجملة، وإنتي كتبتي بخطك الكبير. قرت وراكي وصحّحت كلمتين.",
      "next": "c3_return",
      "effects": {
        "inc": {
          "hoda_corrected_fatma": 1
        }
      }
    },
    {
      "id": "c3_check_home",
      "type": "line",
      "speaker": "narrator",
      "text": "بالليل كتبتوه على الطبلية. هدى نامت قبل ما تكمّل، فكتبتي تحت: «هدى نامت، وبتبوسك.»",
      "next": "c3_return"
    },
    {
      "id": "c3_return",
      "type": "line",
      "speaker": "hoda",
      "text": "لما ماما تيجي، هوريها الكراسة والكورة. والشنطة هتبقى جاهزة.",
      "lead": "محمود خد الجواب للبوستة.",
      "next": "c3_place",
      "effects": {
        "flags": {
          "search_reply_sent": true
        }
      },
      "expr": "smile"
    },
    {
      "id": "c3_place",
      "type": "choice",
      "prompt": "الشنطة لسه مفتوحة. تعملي إيه؟",
      "options": [
        {
          "text": "«تحبي نحط شوية هدوم في الدولاب؟ والباقي زي ما انتي عايزة.»",
          "goto": "c3_place_wardrobe",
          "effects": {
            "vars": {
              "safety": 3,
              "autonomy": 2
            },
            "flags": {
              "c3_bag_place": "wardrobe"
            }
          }
        },
        {
          "text": "«سيبيها مكانها. انتي اللي تقرري.»",
          "goto": "c3_place_open",
          "effects": {
            "vars": {
              "autonomy": 3,
              "trust": 1
            },
            "flags": {
